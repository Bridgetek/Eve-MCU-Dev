{
    "version": "1.9",
    "importedFrom": "./",
    "propertyGroups": [
        {
            "name": "default-uservariables",
            "type": "uservariables",
            "properties": {}
        },
        {
            "name": "default-XC8",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc8@3.10",
            "properties": {
                "HI-TECH-COMP.define-macros": [
                    "PLATFORM_PIC",
                    "MACRO=2"
                ],
                "HI-TECH-COMP.disable-optimizations": false,
                "HI-TECH-COMP.extra-include-directories": [
                    "../common",
                    "../../snippets",
                    "../../../include",
                    "."
                ],
                "HI-TECH-COMP.favor-optimization-for": "-speed,+space",
                "HI-TECH-COMP.identifier-length": "255",
                "HI-TECH-COMP.operation-mode": "free",
                "HI-TECH-COMP.opt-xc8-compiler-strict_ansi": false,
                "HI-TECH-COMP.optimization-assembler": true,
                "HI-TECH-COMP.optimization-invariant-enable": false,
                "HI-TECH-COMP.optimization-invariant-value": "16",
                "HI-TECH-COMP.optimization-level": "-O1",
                "HI-TECH-COMP.optimization-speed": false,
                "HI-TECH-COMP.optimization-stable-enable": false,
                "HI-TECH-COMP.tentative-definitions": "-fno-common",
                "HI-TECH-COMP.use-iar": false,
                "HI-TECH-COMP.warning-level": "0",
                "HI-TECH-LINK.additional-options-checksumAVR2": "0",
                "HI-TECH-LINK.additional-options-fillAVR2": "0",
                "HI-TECH-LINK.additional-options-use-response-files": false,
                "HI-TECH-LINK.checksum-flash-options-algorithmc": "Select checksum algorithm",
                "HI-TECH-LINK.checksum-flash-options-offsetc": "0xFFFF",
                "HI-TECH-LINK.checksum-flash-options-widthc": "2",
                "HI-TECH-LINK.clear-bss": true,
                "HI-TECH-LINK.create-html-files": false,
                "HI-TECH-LINK.data-model-size-of-double": "32",
                "HI-TECH-LINK.data-model-size-of-float": "32",
                "HI-TECH-LINK.extra-lib-directories": ".",
                "HI-TECH-LINK.fill-flash-options-how": "0",
                "HI-TECH-LINK.fill-flash-options-wwidthf": "2",
                "HI-TECH-LINK.input-libraries": "m",
                "HI-TECH-LINK.link-in-c-library": true,
                "HI-TECH-LINK.link-in-peripheral-library": false,
                "XC8-config-global.advanced-elf": true,
                "XC8-config-global.gcc-opt-driver-new": true,
                "XC8-config-global.omit-pack-options": false,
                "XC8-config-global.output-file-format": "-mcof,+elf"
            }
        },
        {
            "name": "default-tool",
            "type": "tool",
            "properties": {
                "AutoSelectMemRanges": "auto",
                "Freeze Peripherals": true,
                "SecureSegment.SegmentProgramming": "FullChipProgramming",
                "ToolFirmwareFilePath": "Press to browse for a specific firmware version",
                "ToolFirmwareOption.UpdateOptions": "ToolFirmwareOption.UseLatest",
                "ToolFirmwareToolPack": "Press to select which tool pack to use",
                "communication.activationmode": "nohv",
                "communication.interface.jtag": "2wire",
                "communication.speed": "${communication.speed.default}",
                "debugoptions.debug-startup": "Use system settings",
                "debugoptions.reset-behaviour": "Use system settings",
                "debugoptions.simultaneous.debug": false,
                "debugoptions.useswbreakpoints": false,
                "event.recorder.debugger.behavior": "Running",
                "event.recorder.enabled": false,
                "freeze.timers": false,
                "memories.aux": false,
                "memories.bootflash": true,
                "memories.configurationmemory": true,
                "memories.configurationmemory2": true,
                "memories.dataflash": true,
                "memories.eeprom": true,
                "memories.exclude.configurationmemory": true,
                "memories.flashdata": true,
                "memories.id": true,
                "memories.instruction.ram.ranges": "${memories.instruction.ram.ranges}",
                "memories.programmemory": true,
                "memories.programmemory.ranges": "0-fff",
                "poweroptions.powerenable": true,
                "programmerToGoFilePath": "D:/VisualStudioDevelopment/Trail/debug/default/default_ptg",
                "programmerToGoImageName": "default_ptg",
                "programoptions.donoteraseauxmem": false,
                "programoptions.eraseb4program": true,
                "programoptions.ledbrightness": "5",
                "programoptions.pgcconfig": "pull down",
                "programoptions.pgcresistor.value": "4.7",
                "programoptions.pgdconfig": "pull down",
                "programoptions.pgdresistor.value": "4.7",
                "programoptions.pgmentry.voltage": "high",
                "programoptions.pgmspeed": "Med",
                "programoptions.preservedataflash": false,
                "programoptions.preservedataflash.ranges": "${memories.dataflash.default}",
                "programoptions.preserveeeprom": false,
                "programoptions.preserveeeprom.ranges": "f000-f07f",
                "programoptions.preserveprogramrange": false,
                "programoptions.preserveuserid": false,
                "programoptions.program.otpconfig": false,
                "programoptions.programcalmem": false,
                "programoptions.programuserotp": false,
                "programoptions.smart.program": "When debugging only",
                "programoptions.testmodeentrymethod": "VDDFirst",
                "ptgProgramImage": true,
                "ptgSendImage": true,
                "toolpack.updateoptions": "toolpack.updateoptions.uselatestoolpack",
                "toolpack.updateoptions.packversion": "Press to select which tool pack to use",
                "voltagevalue": "5.0"
            }
        }
    ],
    "fileSets": [
        {
            "name": "Project files",
            "files": [
                "Makefile",
                "PWM_OUT.mc3",
                "PIC16F17114.mc3",
                "mcc_generated_files/spi/**/*",
                "mcc_generated_files/system/**/*",
                "*.mc3",
                "../../../include/*.h",
                "../common/*{.c,.h}",
                "../../../ports/eve_arch_pic/*.c",
                "../../../source/*.c",
                "../../snippets/*.c",
                "main/*.c",
                "../../../source/extensions/bt82x_patch.c",
                "../../../source/extensions/custom_touch_fw.c",
                "../../../source/extensions/lcd_panel_init.c",
                "../../snippets/platform/*.c"
            ],
            "encoding": "ISO-8859-1"
        }
    ],
    "configurations": [
        {
            "name": "default",
            "id": "",
            "device": "PIC18F46K22",
            "imageType": "application",
            "imagePath": "./out/PIC18F46K22/simple_PIC18F.elf",
            "toolProperties": "default-tool",
            "tool": "Simulator",
            "packs": [
                {
                    "name": "PIC18F-K_DFP",
                    "vendor": "Microchip",
                    "version": "1.14.301"
                }
            ],
            "fileSet": "Project files",
            "toolchain": "default-XC8",
            "userVariables": "default-uservariables",
            "includeLegacyMacros": true
        }
    ]
}
